{
  "expo": {
    "name": "Digital Diary",
    "slug": "digital-diary",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "digitaldiary",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#111111",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digitaldiary.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.digitaldiary.app",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0C0C0C"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#D9C84E"
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0C0C0C"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Digital Diary shows your device calendar events alongside your plans."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d91633f-5686-439a-b6ab-33787ef68bda"
      }
    },
    "owner": "madasif"
  }
}
